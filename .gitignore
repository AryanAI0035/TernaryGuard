# === TernaryGuard Monorepo .gitignore ===

# ──────────────── Python ────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so

# Virtual environments
venv/
.venv/
env/
.env/
conda-env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata/

# Training checkpoints stay local; only the small frozen reference is versioned below.
*.pt
*.pth
*.ckpt

# ──────────────── C / AVR ────────────────
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.lst
*.d

# PlatformIO
engine-arduino/.pio/
engine-arduino/.pioenvs/
engine-arduino/.piolibdeps/

# ──────────────── Vivado / FPGA ────────────────
future-scope/fpga/vivado_project/
future-scope/fpga/*.jou
future-scope/fpga/*.log
future-scope/fpga/*.str
future-scope/fpga/*.runs/
future-scope/fpga/*.cache/
future-scope/fpga/*.hw/
future-scope/fpga/*.ip_user_files/
future-scope/fpga/.Xil/
*.bit
*.ltx
*.dcp
*.wdb
*.wcfg

# Vivado IP and simulation caches
future-scope/fpga/xsim.dir/
future-scope/fpga/*.sim/
future-scope/fpga/*.synth/
future-scope/fpga/*.impl/

# ──────────────── Node / React ────────────────
node_modules/
future-scope/dashboard/frontend/build/
future-scope/dashboard/frontend/.next/
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────── General ────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.pytest_cache/

# ──────────────── Data (too large for git) ────────────────
data/
*.csv
!docs/benchmarks/*.csv
!results.csv

# ──────────────── Logs ────────────────
logs/
*.log
.pytest_cache/
Information Theory in DL/
checkpoints/*
!checkpoints/phase3_final_seed42/
checkpoints/phase3_final_seed42/*
!checkpoints/phase3_final_seed42/ternary_2bit.pt
!checkpoints/phase3_final_seed42/data_manifest.json
!checkpoints/phase3_final_seed42/split_rows.npz
data/
# Keep the small validated shared header; full training bundles stay local.
!model_weights.h
