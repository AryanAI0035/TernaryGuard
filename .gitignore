# === TernaryGuard Monorepo .gitignore ===

# ──────────────── Python ────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.so

# Virtual environments
venv/
.venv/
env/
.env/
conda-env/

# Jupyter
.ipynb_checkpoints/
*.ipynb_metadata/

# PyTorch checkpoints — DO NOT commit to git (bloats repo history)
# Final trained model goes in a GitHub Release, not in the tree.
*.pt
*.pth
*.ckpt

# ──────────────── C / AVR ────────────────
*.o
*.obj
*.elf
*.hex
*.bin
*.map
*.lst
*.d

# PlatformIO
engine-arduino/.pio/
engine-arduino/.pioenvs/
engine-arduino/.piolibdeps/

# ──────────────── Vivado / FPGA ────────────────
engine-fpga/vivado_project/
engine-fpga/*.jou
engine-fpga/*.log
engine-fpga/*.str
engine-fpga/*.runs/
engine-fpga/*.cache/
engine-fpga/*.hw/
engine-fpga/*.ip_user_files/
engine-fpga/.Xil/
*.bit
*.ltx
*.dcp
*.wdb
*.wcfg

# Vivado IP and simulation caches
engine-fpga/xsim.dir/
engine-fpga/*.sim/
engine-fpga/*.synth/
engine-fpga/*.impl/

# ──────────────── Node / React ────────────────
node_modules/
dashboard/frontend/build/
dashboard/frontend/.next/
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ──────────────── General ────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/
.pytest_cache/

# ──────────────── Data (too large for git) ────────────────
data/
*.csv
!docs/benchmarks/*.csv
!results.csv

# ──────────────── Logs ────────────────
logs/
*.log
.pytest_cache/
Information Theory in DL/
checkpoints/
data/
model_weights.h
