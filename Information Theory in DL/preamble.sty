% Define Monokai-esque colors for listings
\definecolor{monokai-bg}{HTML}{272822}
\definecolor{monokai-fg}{HTML}{F8F8F2}
\definecolor{monokai-keyword}{HTML}{F92672}
\definecolor{monokai-string}{HTML}{E6DB74}
\definecolor{monokai-comment}{HTML}{75715E}
\definecolor{monokai-function}{HTML}{A6E22E}
\definecolor{monokai-number}{HTML}{AE81FF}

\lstnewenvironment{pycode}[1][]
{\lstset{
  language=Python,
  backgroundcolor=\color{monokai-bg},
  basicstyle=\ttfamily\color{monokai-fg}\small,
  keywordstyle=\color{monokai-keyword}\bfseries,
  stringstyle=\color{monokai-string},
  commentstyle=\color{monokai-comment}\itshape,
  identifierstyle=\color{monokai-fg},
  numberstyle=\tiny\color{monokai-number},
  breaklines=true,
  showstringspaces=false,
  frame=single,
  rulecolor=\color{monokai-bg},
  xleftmargin=10pt,
  xrightmargin=10pt,
  #1
}}{}

% Define \horizon{} environment using tcolorbox
\newtcolorbox{horizon}[1][]{
  enhanced,
  breakable,
  title=Horizon,
  fonttitle=\bfseries\Large,
  coltitle=black,
  attach boxed title to top center={yshift=-3mm,yshifttext=-1mm},
  boxed title style={size=small,colback=white,colframe=black,boxrule=1pt,arc=2pt},
  colback=black!5!white,
  colframe=black,
  boxrule=0.5pt,
  arc=4pt,
  borderline={1pt}{0pt}{black,dashed},
  #1
}

\theoremstyle{definition}
\newtheorem{definition}{Definition}[chapter]
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{lemma}{Lemma}[chapter]
\newtheorem{proposition}{Proposition}[chapter]
\newtheorem{corollary}{Corollary}[chapter]
\newtheorem{conjecture}{Conjecture}[chapter]
